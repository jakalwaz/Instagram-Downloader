{
    "name": "Instagram Downloader",
    "description": "Download Photos and Videos from Instagram Post, Reels, TV, Stories",
    "version": "6.0.4",
    "manifest_version": 3,
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "host_permissions": [
        "https://www.instagram.com/*",
        "https://*.fbcdn.net/*",
        "https://*.cdninstagram.com/*"
    ],
    "action": {
        "default_icon": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.instagram.com/*"
            ],
            "js": [
                "src/js/download-ui-preferences.js",
                "src/js/video-download-preferences.js",
                "src/js/filename-preferences.js",
                "src/js/settings-ui.js"
            ],
            "css": [
                "src/style/style.css"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://www.instagram.com/*"
            ],
            "js": [
                "src/js/utils.js",
                "src/js/dash.js",
                "src/js/muxer-client.js",
                "src/js/story-inline-button.js",
                "src/js/post-inline-button.js",
                "src/js/main.js",
                "src/js/post.js",
                "src/js/story.js",
                "src/js/zip.js",
                "lib/js.cookie.min.js"
            ]
        },
        {
            "matches": [
                "https://www.instagram.com/*"
            ],
            "js": [
                "src/js/main-world-loader.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/muxer/*",
                "lib/mp4box/*",
                "src/js/global/*"
            ],
            "matches": [
                "https://www.instagram.com/*"
            ]
        }
    ]
}
